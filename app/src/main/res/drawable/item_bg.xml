<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjetas y botones: blanco translúcido con borde suave; con el foco, casi blanco con borde melocotón -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#F7FFFFFF" /><stroke android:width="3dp" android:color="@color/focus" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#F7FFFFFF" /><stroke android:width="1dp" android:color="#55B9B2C7" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#80FFFFFF" /><stroke android:width="1dp" android:color="#55B9B2C7" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
