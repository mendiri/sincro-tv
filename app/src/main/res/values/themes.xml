<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A juego con el launcher «Inicio»: fondo crema, texto oscuro, foco melocotón -->
    <color name="bg">#F3E9E4</color>
    <color name="card">#80FFFFFF</color>
    <color name="fg">#2E2A35</color>
    <color name="muted">#5E5966</color>
    <color name="accent">#D9506B</color>
    <color name="focus">#FFC09A</color>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
</resources>
